# Copy to .env. Never commit the resulting file. All values below are examples.
ENVIRONMENT=local
DATA_DIR=data
# Local persistent Qdrant works without a server for one application process.
# Set these for Docker/Cloud deployments; never place keys in browser JavaScript.
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
COLLECTION_PREFIX=investigation
EMBEDDING_BACKEND=fastembed
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_THREADS=2
CHUNK_STRATEGY=structure
CHUNK_TOKENS=256
CHUNK_OVERLAP=40
BM25_AVG_LENGTH=150
RERANKER_ENABLED=true
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
# For source preview without an API key use extractive. Final assignment needs gemini.
LLM_PROVIDER=extractive
LLM_MODEL=gemini-3.5-flash-lite
# GEMINI_API_KEY=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
# Optional spacing between model HTTP attempts, including retries, within one engine.
# Prefer the CLI --request-interval-seconds option for paced evaluation.
LLM_MIN_REQUEST_INTERVAL_SECONDS=0
MAX_TOOL_CALLS=6
MAX_SUBQUESTIONS=4
REQUESTS_PER_MINUTE=12
MAX_CONCURRENT_INVESTIGATIONS=2
# Required together with remote QDRANT_URL when ENVIRONMENT=production.
# Generate e.g. with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# ADMIN_TOKEN=
